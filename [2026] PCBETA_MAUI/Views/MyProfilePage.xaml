<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PCBetaMAUI.ViewModels"
             x:Class="PCBetaMAUI.Views.MyProfilePage"
             Title="个人资料"
             Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:MyProfileViewModel/>
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="BottomNaviButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=White}"/>
                <Setter Property="CornerRadius" Value="50"/>
                <Setter Property="BorderWidth" Value="2"/>
                <Setter Property="BorderColor" Value="LightBlue"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HeightRequest" Value="50"/>
                <Setter Property="WidthRequest" Value="50"/>
                <!--
                                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="DodgerBlue"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="SkyBlue"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="LightBlue"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
                -->
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="64,*,80" Padding="0" BackgroundColor="{AppThemeBinding Light=#F6F8FC, Dark=#151A24}">
        <!-- Header -->
        <Grid ColumnDefinitions="50,*,50" Padding="15,0" >
            <Button Text="←" 
                    FontSize="20"
                    BackgroundColor="Transparent"
                    TextColor="#1985DB"
                    Command="{Binding GoBackCommand}"
                    Padding="0"
                    Margin="0" IsVisible="False"/>
            <Label Text="个人资料" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center" 
                   FontAttributes="Bold" 
                   FontSize="16"
                   Grid.Column="1"/>
            <Button Text="⟳" 
                    FontSize="20"
                    BackgroundColor="Transparent"
                    TextColor="#1985DB"
                    Command="{Binding RefreshCommand}"
                    Padding="0"
                    Margin="0"
                    Grid.Column="2" IsVisible="False"/>
        </Grid>

        <!-- Content Area -->
        <ScrollView Grid.Row="1" >
            <VerticalStackLayout Spacing="0" Padding="0">
                
                <!-- Loading Indicator -->
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                  IsVisible="{Binding IsLoading}"
                                  Color="#1985DB"
                                  VerticalOptions="Center"
                                  HorizontalOptions="Center"
                                  Scale="1.5"
                                  Margin="0,40,0,0"/>

                <!-- Error Message -->
                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullToBoolConverter}}"
                       TextColor="Red"
                       FontSize="14"
                       HorizontalOptions="Center"
                       Margin="15,20"/>

                <!-- Profile Content (Hidden when loading) -->
                <VerticalStackLayout Spacing="0" Padding="0" IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                    
                    <!-- 头像和用户名区域 -->
                    <VerticalStackLayout Spacing="15" Padding="24" HorizontalOptions="Center" Margin="0,20,0,0">
                        <Frame WidthRequest="100" HeightRequest="100" CornerRadius="50" Padding="0" HorizontalOptions="Center" HasShadow="False" BorderColor="Transparent">
                            <Image Source="{Binding ProfileInfo.AvatarSource}"
                                   Aspect="AspectFill"/>
                        </Frame>
                        <Label Text="{Binding ProfileInfo.Username}"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#1985DB, Dark=#5DADE2}"/>
                    </VerticalStackLayout>

                    <!-- 分隔线 -->
                    <BoxView HeightRequest="1" Margin="0,10,0,10" Color="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}"/>

                    <!-- 账户信息区域 -->
                    <VerticalStackLayout Padding="20" Spacing="14" BackgroundColor="{AppThemeBinding Light=#F6F8FC, Dark=#151A24}" Margin="12,0">
                        <Label Text="账户信息" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1985DB, Dark=#5DADE2}"/>
                        
                        <!-- 第一行：UID | 空间访问量 | 邮箱状态 -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="UID" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.Uid}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" Grid.Column="1">
                                <Label Text="空间访问量" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.SpacePV}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" Grid.Column="2">
                                <Label Text="邮箱状态" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.EmailStatus}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- 第二行：回帖数 | 主题数 | 好友数 -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="回帖数" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.ReplyCount}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" Grid.Column="1">
                                <Label Text="主题数" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.ThreadCount}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" Grid.Column="2">
                                <Label Text="好友数" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.FriendCount}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- 第三行：积分 | PB币 | 威望 -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="积分" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.Credits}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" Grid.Column="1">
                                <Label Text="PB币" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.PBCoins}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" Grid.Column="2">
                                <Label Text="威望" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.Reputation}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- 第四行：贡献 | 技术 | 活跃 -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="贡献" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.Contribution}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" Grid.Column="1">
                                <Label Text="技术" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.Technology}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" Grid.Column="2">
                                <Label Text="活跃" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.Activity}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- 第五行：记录数 | 日志数 | 相册数 -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="记录数" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.RecordCount}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" Grid.Column="1">
                                <Label Text="日志数" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.BlogCount}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" Grid.Column="2">
                                <Label Text="相册数" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.AlbumCount}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- 第六行：分享数 | 已用空间 -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="分享数" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.ShareCount}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" Grid.Column="1">
                                <Label Text="已用空间" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.UsedSpace}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                            </VerticalStackLayout>
                            <!-- Empty cell for layout -->
                            <Grid Grid.Column="2"/>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- 分隔线 -->
                    <BoxView HeightRequest="1" Margin="0,10,0,10" Color="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}"/>

                    <!-- 荣誉信息区域 -->
                    <VerticalStackLayout Padding="15" Spacing="12">
                        <Label Text="荣誉信息" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1985DB, Dark=#5DADE2}"/>
                        
                        <!-- 勋章列表 -->
                        <CollectionView ItemsSource="{Binding ProfileInfo.Medals}"
                                       IsVisible="{Binding HasMedals}"
                                       SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical"
                                               HorizontalItemSpacing="10"
                                               VerticalItemSpacing="10"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Image Source="{Binding ImageSource}"
                                              WidthRequest="60"
                                              HeightRequest="60"
                                              Aspect="AspectFit"
                                              HorizontalOptions="Center"/>
                                        <Label Text="{Binding Name}"
                                              FontSize="12"
                                              TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                              HorizontalTextAlignment="Center"
                                              LineBreakMode="WordWrap"
                                              MaxLines="2"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- No Medals Message -->
                        <Label Text="暂无勋章，加油获取！"
                              IsVisible="{Binding HasMedals, Converter={StaticResource InvertedBoolConverter}}"
                              FontSize="13"
                              TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"
                              HorizontalOptions="Center"
                              Padding="15"/>
                    </VerticalStackLayout>

                    <!-- 分隔线 -->
                    <BoxView HeightRequest="1" Margin="0,10,0,10" Color="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}"/>

                    <!-- 活跃概况区域 -->
                    <VerticalStackLayout Padding="15" Spacing="12">
                        <Label Text="活跃概况" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1985DB, Dark=#5DADE2}"/>

                        <!-- 第一行：用户组 | 注册时间 | 最后访问 -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="用户组" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.UserGroup}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" Grid.Column="1">
                                <Label Text="注册时间" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.RegisterTime}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" Grid.Column="2">
                                <Label Text="最后访问" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.LastAccessTime}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- 第二行：上次访问 | 上次活动时间 | 上次发表时间 -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="上次访问IP" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.LastVisitIP}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" Grid.Column="1">
                                <Label Text="上次活动时间" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.LastActivityTime}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" Grid.Column="2">
                                <Label Text="上次发表时间" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                <Label Text="{Binding ProfileInfo.LastPostTime}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- 第三行：所在时区 -->
                            <VerticalStackLayout Spacing="4">
                            <Label Text="所在时区" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                            <Label Text="{Binding ProfileInfo.Timezone}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Navigation -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" BackgroundColor="{AppThemeBinding Light=#F6F8FC, Dark=#202938}" Padding="0,5">
            <StackLayout>
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource BottomNaviButtonStyle}" >
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xE72c;" Size="Medium" Color="{AppThemeBinding Light=Black, Dark=White}" FontFamily="Segoe Fluent Icons"/>
                    </Button.ImageSource>
                </Button>
                <Label Text="刷新" HorizontalOptions="Center" FontSize="12" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
            </StackLayout>
            <StackLayout Grid.Column="1">
                <Button Command="{Binding GoBackCommand}" Style="{StaticResource BottomNaviButtonStyle}">
                    <Button.ImageSource>
                        <FontImageSource  Glyph="&#xE760;" Size="Large" Color="{AppThemeBinding Light=Black, Dark=White}" FontFamily="Segoe Fluent Icons"/>
                    </Button.ImageSource>
                </Button>
                <Label Text="返回" HorizontalOptions="Center" FontSize="12" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>
