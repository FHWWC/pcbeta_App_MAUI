<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PCBetaMAUI.ViewModels"
             xmlns:models="clr-namespace:PCBetaMAUI.Models"
             x:Class="PCBetaMAUI.Views.EditReplyPage"
             Title="编辑回帖"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F1F1F}">

    <!-- 绑定 EditReplyViewModel -->
    <ContentPage.BindingContext>
        <vm:EditReplyViewModel/>
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- 删除按钮样式 -->
            <Style x:Key="DeleteButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#FF4444"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <!-- 操作按钮样式 -->
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#007AFF"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto" Padding="0">
        <!-- 主内容区 -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- ✅ 编辑模式指示 -->
                <Frame BorderColor="#FFB800" 
                       CornerRadius="8" 
                       Padding="12" 
                       HasShadow="False">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="✏️ 编辑模式" 
                               FontSize="12" 
                               FontAttributes="Bold"
                               TextColor="#FFB800"/>
                        <Label Text="修改您之前发表的回帖内容和附件信息" 
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- 帖子信息 -->
                <Frame BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3F3F3F}" 
                       CornerRadius="8" 
                       Padding="12" 
                       HasShadow="False">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding ThreadTitle}" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation"
                               MaxLines="2"/>
                        <Label Text="{Binding ThreadInfo}" 
                               FontSize="12" 
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- 原始内容展示（只读） -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="原始内容" FontSize="14" FontAttributes="Bold"/>
                    <Frame BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3F3F3F}"
                           CornerRadius="6"
                           Padding="12"
                           HasShadow="False"
                           BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}">
                        <Label Text="{Binding OriginalContent}" 
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}"
                               LineBreakMode="WordWrap"/>
                    </Frame>
                </VerticalStackLayout>

                <!-- 回帖内容编辑区 -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="编辑内容" FontSize="14" FontAttributes="Bold"/>
                    <Editor x:Name="ReplyEditor"
                            Text="{Binding ReplyContent}"
                            Placeholder="请输入修改后的回帖内容（至少8个字符）"
                            HeightRequest="200"
                            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2F2F2F}"
                            TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                            PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#666666}"/>
                    <Label Text="{Binding CharacterCount, StringFormat='已输入: {0} 字符'}" 
                           FontSize="12" 
                           TextColor="{AppThemeBinding Light=#999999, Dark=#AAAAAA}"/>
                </VerticalStackLayout>

                <!-- 图片上传区 -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="上传图片" FontSize="14" FontAttributes="Bold"/>
                    <Button Text="选择图片" 
                            Command="{Binding PickImageCommand}"
                            Style="{StaticResource ActionButtonStyle}"/>
                    
                    <!-- 已上传的图片列表 -->
                    <CollectionView ItemsSource="{Binding UploadedImages}" 
                                   SelectionMode="None"
                                   Margin="0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="8" Margin="0,4">
                                    <!-- 图片基本信息卡片 -->
                                    <Frame BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3F3F3F}"
                                           CornerRadius="6"
                                           Padding="8"
                                           HasShadow="False">
                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <!-- 图片缩略图 -->
                                            <Image Source="{Binding LocalPath}"
                                                   WidthRequest="60"
                                                   HeightRequest="60"
                                                   Aspect="AspectFill"/>
                                            
                                            <!-- 图片信息 -->
                                            <VerticalStackLayout Spacing="4" HorizontalOptions="FillAndExpand">
                                                <Label Text="{Binding FileName}" 
                                                       FontSize="12" 
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding FileSize, StringFormat='大小: {0}'}" 
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light=#999999, Dark=#AAAAAA}"/>
                                                <Label Text="{Binding StatusText}" 
                                                       FontSize="10"
                                                       TextColor="{Binding StatusColor}"/>
                                            </VerticalStackLayout>
                                            
                                            <!-- 操作按钮区 -->
                                            <HorizontalStackLayout Spacing="4">
                                                <!-- 插入按钮 -->
                                                <Button Text="插入" 
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.InsertImageCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#34C759"
                                                        TextColor="White"
                                                        Padding="6,4"
                                                        FontSize="11"
                                                        WidthRequest="45"/>

                                                <!-- 删除按钮 -->
                                                <Button Text="删除" 
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteImageCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource DeleteButtonStyle}"
                                                        WidthRequest="45"
                                                        Padding="0"/>
                                            </HorizontalStackLayout>
                                        </HorizontalStackLayout>
                                    </Frame>

                                    <!-- 附件元数据输入区域 -->
                                    <Frame BorderColor="{AppThemeBinding Light=#F0F0F0, Dark=#2F2F2F}"
                                           CornerRadius="6"
                                           Padding="12"
                                           HasShadow="False"
                                           BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#282828}">
                                        <VerticalStackLayout Spacing="8">
                                            <!-- 附件描述 -->
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="📝 附件描述（可选）" 
                                                       FontSize="12" 
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"/>
                                                <Entry Text="{Binding Description, Mode=TwoWay}" 
                                                       Placeholder="输入此附件的描述信息"
                                                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#3F3F3F}"
                                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                                       PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#666666}"
                                                       FontSize="12"/>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Frame>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- 附件上传区 -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="上传附件" FontSize="14" FontAttributes="Bold"/>
                    <Button Text="选择附件" 
                            Command="{Binding PickAttachmentCommand}"
                            Style="{StaticResource ActionButtonStyle}"/>
                    
                    <!-- 已上传的附件列表 -->
                    <CollectionView ItemsSource="{Binding UploadedAttachments}" 
                                   SelectionMode="None"
                                   Margin="0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="8" Margin="0,4">
                                    <!-- 附件基本信息卡片 -->
                                    <Frame BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3F3F3F}"
                                           CornerRadius="6"
                                           Padding="8"
                                           HasShadow="False">
                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <!-- 附件图标 -->
                                            <Label Text="📎" FontSize="24" WidthRequest="40"/>
                                            
                                            <!-- 附件信息 -->
                                            <VerticalStackLayout Spacing="4" HorizontalOptions="FillAndExpand">
                                                <Label Text="{Binding FileName}" 
                                                       FontSize="12" 
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding FileSize, StringFormat='大小: {0}'}" 
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light=#999999, Dark=#AAAAAA}"/>
                                                <Label Text="{Binding StatusText}" 
                                                       FontSize="10"
                                                       TextColor="{Binding StatusColor}"/>
                                            </VerticalStackLayout>

                                            <!-- 操作按钮区 -->
                                            <HorizontalStackLayout Spacing="4">
                                                <!-- 插入按钮 -->
                                                <Button Text="插入" 
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.InsertAttachmentCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#34C759"
                                                        TextColor="White"
                                                        Padding="6,4"
                                                        FontSize="11"
                                                        WidthRequest="45"/>

                                                <!-- 删除按钮 -->
                                                <Button Text="删除" 
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteAttachmentCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource DeleteButtonStyle}"
                                                        WidthRequest="45"
                                                        Padding="0"/>
                                            </HorizontalStackLayout>
                                        </HorizontalStackLayout>
                                    </Frame>

                                    <!-- 附件元数据输入区域 -->
                                    <Frame BorderColor="{AppThemeBinding Light=#F0F0F0, Dark=#2F2F2F}"
                                           CornerRadius="6"
                                           Padding="12"
                                           HasShadow="False"
                                           BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#282828}">
                                        <VerticalStackLayout Spacing="8">
                                            <!-- 附件描述 -->
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="📝 附件描述（可选）" 
                                                       FontSize="12" 
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"/>
                                                <Entry Text="{Binding Description, Mode=TwoWay}" 
                                                       Placeholder="输入此附件的描述信息"
                                                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#3F3F3F}"
                                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                                       PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#666666}"
                                                       FontSize="12"/>
                                            </VerticalStackLayout>

                                            <!-- 阅读权限 -->
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="🔐 阅读权限" 
                                                       FontSize="12" 
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"/>
                                                <Picker SelectedItem="{Binding SelectedPermission, Mode=TwoWay}"
                                                        ItemsSource="{x:Static models:AttachmentPermissionLevel.PermissionOptions}"
                                                        ItemDisplayBinding="{Binding Display}"
                                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#3F3F3F}"
                                                        TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                                        Title="选择权限"
                                                        FontSize="12"/>
                                            </VerticalStackLayout>

                                            <!-- 售价 -->
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="💰 售价（金币，0为免费）" 
                                                       FontSize="12" 
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"/>
                                                <Entry Text="{Binding Price, Mode=TwoWay}" 
                                                       Placeholder="0"
                                                       Keyboard="Numeric"
                                                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#3F3F3F}"
                                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                                       PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#666666}"
                                                       FontSize="12"/>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Frame>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 底部操作栏 -->
        <HorizontalStackLayout Grid.Row="1" 
                              Padding="16" 
                              Spacing="8"
                              BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#2F2F2F}">
            <Button Text="取消" 
                    Command="{Binding CancelCommand}"
                    BackgroundColor="#CCCCCC"
                    TextColor="Black"/>
            <Button Text="更新" 
                    Command="{Binding SubmitEditCommand}"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    IsEnabled="{Binding IsSubmitEnabled}"
                    Clicked="OnSubmitButtonClicked"/>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
