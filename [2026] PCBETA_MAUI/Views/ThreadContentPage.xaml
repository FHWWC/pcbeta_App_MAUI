<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PCBetaMAUI.ViewModels"
             xmlns:models="clr-namespace:PCBetaMAUI.Models"
             xmlns:local="clr-namespace:PCBetaMAUI.Behaviors"
             x:Class="PCBetaMAUI.Views.ThreadContentPage"
             Title="帖子内容">

    <ContentPage.BindingContext>
        <vm:ThreadContentViewModel/>
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="BottomNaviButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=White}"/>
                <Setter Property="CornerRadius" Value="50"/>
                <Setter Property="BorderWidth" Value="2"/>
                <Setter Property="BorderColor" Value="LightBlue"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HeightRequest" Value="50"/>
                <Setter Property="WidthRequest" Value="50"/>
                <!--
                                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="DodgerBlue"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="SkyBlue"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="LightBlue"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
                -->
            </Style>
            <Style x:Key="MordenButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="DodgerBlue"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="HeightRequest" Value="30"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="DodgerBlue"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="SkyBlue"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="LightBlue"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid RowDefinitions="*,100" BackgroundColor="{AppThemeBinding Light=#F6F8FC, Dark=#151A24}">
        <ScrollView x:Name="MainScrollView" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
            <VerticalStackLayout Padding="18,16" Spacing="16" BackgroundColor="{AppThemeBinding Light=#F6F8FC, Dark=#151A24}">
                <!-- 帖子标题 -->
                <Label Text="{Binding ThreadTitle}"
                   FontSize="20" 
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                <!-- 作者信息 -->
                <Border Padding="14" StrokeShape="{RoundRectangle CornerRadius=14}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=White, Dark=#202938}">
                    <VerticalStackLayout Spacing="5">
                        <HorizontalStackLayout>
                            <Label FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}">作者：</Label>
                            <Label Text="{Binding Author}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout>
                            <Label Text="{Binding PostTime}" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}" FontSize="12"/>
                            <Label Text="帖子ID" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}" FontSize="12"  Margin="10,0,0,0"/>
                            <Label Text="{Binding ThreadID}" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}" FontSize="12" Margin="5,0,0,0"/>
                            <Label Text="{Binding OtherIfm}" TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}" FontSize="12" Margin="20,0,0,0"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="10"
                        StrokeShape="{RoundRectangle CornerRadius=8}"
                        Stroke="#F0B429"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#3A321E}"
                        IsVisible="{Binding ReplyRewardText, Converter={StaticResource StringNotNullToBoolConverter}}">
                    <Label Text="{Binding ReplyRewardText}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#8A5A00, Dark=#FFD166}"
                           LineBreakMode="WordWrap" />
                </Border>

                <!--  编辑状态信息 - 本帖最后由...编辑 -->
                <Border Padding="10" 
                    StrokeShape="{RoundRectangle CornerRadius=5}" 
                    Stroke="#FFB6C1" 
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D2D}"
                    IsVisible="{Binding EditStatus, Converter={StaticResource StringNotNullToBoolConverter}}">
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="✏️" FontSize="14"/>
                        <Label Text="{Binding EditStatus}" 
                           TextColor="#C71585" 
                           FontSize="12"
                           LineBreakMode="WordWrap"/>
                    </HorizontalStackLayout>
                </Border>

                <!--  审核通过信息 - 本主题由...审核通过 -->
                <Border Padding="10" 
                    StrokeShape="{RoundRectangle CornerRadius=5}" 
                    Stroke="#90EE90" 
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D2D}"
                    IsVisible="{Binding ModerationInfo, Converter={StaticResource StringNotNullToBoolConverter}}">
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="✓" FontSize="14" TextColor="Green"/>
                        <Label Text="{Binding ModerationInfo}" 
                           TextColor="#228B22" 
                           FontSize="12"
                           LineBreakMode="WordWrap"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- 动态富文本内容容器 - 这是关键！ -->
                <VerticalStackLayout x:Name="ContentContainer"
                                Spacing="5"
                                Padding="0"/>

                <Border Padding="15"
                        StrokeShape="{RoundRectangle CornerRadius=5}"
                        Stroke="#D9EAF7"
                        BackgroundColor="{AppThemeBinding Light=#F5FAFF, Dark=#263746}"
                        IsVisible="{Binding HasPoll}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="投票"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#1985DB"/>
                        <Label Text="{Binding Poll.Summary}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#555555, Dark=#DDDDDD}" FontAttributes="Bold"/>
                        <Label Text="{Binding Poll.EndTimeText}"
                               FontSize="12"
                               IsVisible="{Binding Poll.EndTimeText, Converter={StaticResource StringNotNullToBoolConverter}}"
                               TextColor="#C56A00" FontAttributes="Bold"/>
                        <CollectionView ItemsSource="{Binding Poll.Options}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:PollOption">
                                    <VerticalStackLayout Spacing="4" Padding="0,5">
                                        <Grid ColumnDefinitions="Auto,* ,Auto" ColumnSpacing="8">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Poll.CanVote}"
                                                      IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Poll.CanVote}"
                                                      CheckedChanged="PollOption_CheckedChanged"/>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                <Image Source="{Binding ImageUrl}"
                                                       HeightRequest="90"
                                                       Aspect="AspectFit"
                                                       IsVisible="{Binding ImageUrl, Converter={StaticResource StringNotNullToBoolConverter}}"/>
                                                <Label Text="{Binding Text}"
                                                       FontSize="13"
                                                       LineBreakMode="WordWrap"
                                                       TextColor="{AppThemeBinding Light=#222222, Dark=White}"/>
                                                <ProgressBar Progress="{Binding Percentage, Converter={StaticResource PercentageToProgressConverter}}"
                                                             ProgressColor="#1985DB"
                                                             BackgroundColor="{AppThemeBinding Light=#D9EAF7, Dark=#40566B}"
                                                             HeightRequest="8"
                                                             VerticalOptions="Center"
                                                             Margin="0,2,0,0"/>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2"
                                                   Text="{Binding Percentage, StringFormat='{0:F2}%'}"
                                                   FontSize="12"
                                                   VerticalOptions="Center"
                                                   TextColor="#1985DB"/>
                                        </Grid>
                                        <Label Text="{Binding VoteCount, StringFormat='{0} 票'}"
                                               FontSize="11"
                                               Margin="38,0,0,0"
                                               TextColor="{AppThemeBinding Light=#888888, Dark=#BBBBBB}"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="{Binding Poll.Notice}"
                               FontSize="12"
                               IsVisible="{Binding Poll.Notice, Converter={StaticResource StringNotNullToBoolConverter}}"
                               TextColor="#C56A00" FontAttributes="Bold"/>
                        <Button Text="提交投票"
                                Command="{Binding SubmitPollCommand}"
                                IsVisible="{Binding Poll.CanVote}"
                                Style="{StaticResource MordenButtonStyle}"/>
                    </VerticalStackLayout>
                </Border>

                <!--  新增：点评（评论）部分 -->
                <Border Padding="15" 
                    StrokeShape="{RoundRectangle CornerRadius=5}" 
                    Stroke="#E6F3FF" 
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=#F5F9FF, Dark=#2D3D4D}"
                    IsVisible="{Binding HasComments}">
                    <VerticalStackLayout Spacing="10">
                        <!--  可点击的标题栏 - 展开/收回 -->
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleCommentsExpandedCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>

                        <Grid ColumnDefinitions="100,*">
                            <!-- 标题 -->
                            <Label Text="💬 点评" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="#1985DB"    />
                            <!--  展开/收回符号 -->
                            <Label Text="{Binding AreCommentsExpanded, Converter={StaticResource ExpandedToSymbolConverter}}" 
                           FontSize="30" 
                               TextColor="#1985DB" HorizontalOptions="End" Margin="0,-5,0,0" Grid.Column="1"/>
                        </Grid>

                        <!-- 评论列表（根据展开状态控制可见性）-->
                        <CollectionView ItemsSource="{Binding Comments}"
                                    SelectionMode="None"
                                    IsVisible="{Binding AreCommentsExpanded}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:CommentInfo">
                                    <VerticalStackLayout Padding="0,8" Spacing="5" Margin="0,0,0,10" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                        <!-- 评论者信息行 -->
                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <!-- 头像 -->
                                            <Frame CornerRadius="16" Padding="0" HasShadow="False" BorderColor="Transparent">
                                                 <Image Source="{Binding AvatarSource}"
                                                   WidthRequest="32"
                                                   HeightRequest="32"
                                                   Aspect="AspectFill"/>
                                            </Frame>

                                            <!-- 用户名和时间 -->
                                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Username}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"
                                                   TextColor="#1985DB"/>
                                                <Label Text="{Binding Timestamp}"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light=#999999, Dark=#B0B0B0}"/>
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>

                                        <!-- 评论文本 -->
                                        <Label Text="{Binding CommentText}"
                                           FontSize="12"
                                           LineBreakMode="WordWrap"
                                           Margin="40,0,0,0"
                                           TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"/>

                                        <!-- 分隔线 -->
                                        <BoxView HeightRequest="0.5" 
                                             Color="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                                             Margin="0,5,0,0"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!--  新增：评分部分 -->
                <Border Padding="15" 
                    StrokeShape="{RoundRectangle CornerRadius=5}" 
                    Stroke="#FFF0F5" 
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=#FFF8FC, Dark=#3D2D3D}"
                    IsVisible="{Binding HasRatings}">
                    <VerticalStackLayout Spacing="10">
                        <!--  可点击的标题栏 - 展开/收回 -->
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleRatingsExpandedCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>

                        <!-- 标题和总数 -->
                        <Grid ColumnDefinitions="100,*">
                            <HorizontalStackLayout>
                                <Label Text="⭐ " 
                               FontSize="30" 
                               TextColor="#C71585"
                               Margin="0,-10,0,0"/>
                                <Label Text="评分" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="#C71585"
                               HorizontalOptions="Start"/>
                                <Label Text="{Binding RatingSummaryData.TotalRatingCount, StringFormat='({0} 人)'}"
                               FontSize="14"
                               TextColor="#C71585" Margin=" 5,0,0,0" />

                                <!-- 查看全部链接 -->
                                <Label Text="查看全部"
                            IsVisible="{Binding RatingSummaryData.ViewAllRatingsUrl, Converter={StaticResource StringNotNullToBoolConverter}}"
                            FontSize="12"
                            TextColor="#1985DB"
                            TextDecorations="Underline" Margin=" 20,2,0,0" >
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>

                            <!--  展开/收回符号 -->
                            <Label Text="{Binding AreRatingsExpanded, Converter={StaticResource ExpandedToSymbolConverter}}" 
                               FontSize="30" 
                               TextColor="#C71585"
 HorizontalOptions="End" Margin="0,-5,0,0" Grid.Column="1"/>
                        </Grid>

                        <!-- 评分详情列表（根据展开状态控制可见性）-->
                        <CollectionView ItemsSource="{Binding RatingSummaryData.RatingDetails}"
                                    SelectionMode="None"
                                    IsVisible="{Binding AreRatingsExpanded}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:RatingInfo">
                                    <VerticalStackLayout Padding="0,8" Spacing="5" Margin="0,0,0,8" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                        <!-- 评分者信息行 -->
                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <!-- 头像 -->
                                            <Frame CornerRadius="14" Padding="0" HasShadow="False" BorderColor="Transparent">
                                                 <Image Source="{Binding AvatarSource}"
                                                   WidthRequest="28"
                                                   HeightRequest="28"
                                                   Aspect="AspectFill"/>
                                            </Frame>

                                            <!-- 用户名 -->
                                            <Label Text="{Binding Username}"
                                               FontAttributes="Bold"
                                               FontSize="12"
                                               TextColor="#C71585"
                                               VerticalOptions="Center"/>
                                        </HorizontalStackLayout>

                                        <!-- 评分内容 -->
                                        <Label Text="{Binding RatingContent}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light=#666666, Dark=#B0B0B0}"
                                           Margin="36,0,0,0"
                                           LineBreakMode="WordWrap"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!--  操作面板 -->
                <Border Padding="10" 
                    StrokeShape="{RoundRectangle CornerRadius=5}" 
                    Stroke="#d6ffd1" 
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=#e9ffe6, Dark=#2D3D2D}" IsVisible="{Binding HasContent}">
                    <Grid>
                        <HorizontalStackLayout HorizontalOptions="End">
                            <!-- 收藏按钮 -->
                            <Button Style="{StaticResource BottomNaviButtonStyle}" HeightRequest="45" WidthRequest="45" CornerRadius="10" Command="{Binding FavoriteCommand}" Margin="0,0,10,0">
                                <Button.ImageSource>
                                    <FontImageSource Glyph="&#xe734;" Size="Medium" Color="{AppThemeBinding Light=DodgerBlue, Dark=LightBlue}" FontFamily="Segoe Fluent Icons"/>
                                </Button.ImageSource>
                            </Button>
                            <!-- 分享按钮 -->
                            <Button Style="{StaticResource BottomNaviButtonStyle}" HeightRequest="45" WidthRequest="45" CornerRadius="10" Command="{Binding ShareBtnCommand}">
                                <Button.ImageSource>
                                    <FontImageSource Glyph="&#xe72d;" Size="Medium" Color="{AppThemeBinding Light=DodgerBlue, Dark=LightBlue}" FontFamily="Segoe Fluent Icons"/>
                                </Button.ImageSource>
                            </Button>
                        </HorizontalStackLayout>

                    </Grid>
                </Border>
                
                <!--  新增：回帖部分 -->
                <Border x:Name="RepliesBorder" Padding="15" 
                    StrokeShape="{RoundRectangle CornerRadius=5}" 
                    Stroke="#F0E68C" 
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=#FFFACD, Dark=#3D3D2D}"
                    IsVisible="{Binding HasReplies}">
                    <VerticalStackLayout Spacing="12">
                        <!--  可点击的标题栏 - 展开/收回 -->
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleRepliesExpandedCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>

                        <!-- 标题和总数 -->
                        <Grid ColumnDefinitions="120,*">
                            <HorizontalStackLayout>
                                <Label Text="📝 " 
                               FontSize="22" 
                               Margin="0,-2,0,0"/>
                                <Label Text="回帖" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="#D2691E"/>
                                <Label Text="{Binding ReplyList.Count, StringFormat='(当前页面 {0} 条)'}"
                               FontSize="14"
                               TextColor="#D2691E" Margin="5,0,0,0" />
                            </HorizontalStackLayout>

                            <!--  展开/收回符号 -->
                            <Label Text="{Binding AreRepliesExpanded, Converter={StaticResource ExpandedToSymbolConverter}}" 
                               FontSize="30" 
                               TextColor="#D2691E"
                               HorizontalOptions="End" Margin="0,-5,0,0" Grid.Column="1"/>
                        </Grid>

                        <!-- 回帖列表（根据展开状态控制可见性）-->
                        <CollectionView ItemsSource="{Binding ReplyList}"
                                    SelectionMode="None"
                                    IsVisible="{Binding AreRepliesExpanded}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12" 
                                        Margin="0,0,0,12"
                                        StrokeShape="{RoundRectangle CornerRadius=5}" 
                                        Stroke="#DAA520" 
                                        StrokeThickness="1"
                                        BackgroundColor="{AppThemeBinding Light=#FFFEF0, Dark=#2D2D1E}">
                                        <VerticalStackLayout Spacing="8">
                                            <!-- 2. 用户信息行 -->
                                            <Grid ColumnDefinitions="200,*">
                                                <HorizontalStackLayout Spacing="8" Padding="0,5,0,0">
                                                    <!-- 头像 -->
                                                    <Frame CornerRadius="20" Padding="0" HasShadow="False" BorderColor="#D2691E">
                                                         <Image Source="{Binding AvatarSource}"
                                                     WidthRequest="38"
                                                     HeightRequest="38"
                                                     Aspect="AspectFill"/>
                                                    </Frame>

                                                    <!-- 用户名和UID -->
                                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                        <Label Text="{Binding Username}"
                                                     FontAttributes="Bold"
                                                     FontSize="14"
                                                     TextColor="#D2691E"/>
                                                        <Label Text="{Binding UserId, StringFormat='UID: {0}'}"
                                                     FontSize="14"
                                                     TextColor="{AppThemeBinding Light=#999999, Dark=#B0B0B0}"/>
                                                    </VerticalStackLayout>
                                                </HorizontalStackLayout>

                                                <!-- 1. 楼层号和时间信息行 -->
                                                <Grid Grid.Column="1" Margin="5">
                                                    <!-- 楼层号 -->
                                                    <Label Text="{Binding FloorNumber}"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light=#999999, Dark=#B0B0B0}"
                                           Grid.Column="2"
                                           HorizontalOptions="End"
                                           Margin="0,0,0,0"/>
                                                </Grid>
                                            </Grid>
                                            <Grid ColumnDefinitions="120,*" Grid.Column="1">
                                                <!-- IP属地 -->
                                                <Label Text="{Binding IPLocation}" 
                                           FontSize="14"
                                            TextColor="{AppThemeBinding Light=#999999, Dark=#B0B0B0}"/>

                                                <!-- 发帖时间 -->
                                                <Label Text="{Binding PostTime}"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light=#999999, Dark=#B0B0B0}"
                                           Grid.Column="1"
                                           Margin="10,0,0,0"/>
                                            </Grid>

                                             <Label Text="{Binding ReplyRewardText}"
                                                    FontSize="12"
                                                    TextColor="#C56A00"
                                                    LineBreakMode="WordWrap"
                                                    IsVisible="{Binding ReplyRewardText, Converter={StaticResource StringNotNullToBoolConverter}}"
                                                    Margin="0,0,0,2" />

                                            <!-- 3. 编辑状态（如有）-->
                                            <Label Text="{Binding EditStatus}"
                                               FontSize="10"
                                               TextColor="#C71585"
                                               ClassId="reply_edit_status"
                                               IsVisible="{Binding EditStatus, Converter={StaticResource StringNotNullToBoolConverter}}"
                                               Margin="0,5,0,0"/>

                                            <!-- 4. 回帖内容 - 使用 Behavior 动态渲染 ContentElements -->
                                            <VerticalStackLayout Spacing="5" Padding="0">
                                                <VerticalStackLayout.Behaviors>
                                                    <local:ReplyContentRenderBehavior/>
                                                </VerticalStackLayout.Behaviors>
                                            </VerticalStackLayout>

                                            <!-- 5. 操作按钮 -->
                                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10" Margin="0,8,0,0" ClassId="reply_actions" IsVisible="{Binding CanReply}">
                                                <Button Text="点评" 
                                                    BackgroundColor="#D2691E" 
                                                    TextColor="White"
                                                    FontSize="12"
                                                    Padding="5,3"
                                                    IsVisible="{Binding CanComment}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCommentCommand}"
                                                    CommandParameter="{Binding .}"/>
                                                <Button Text="评分" 
                                                    BackgroundColor="#D2691E" 
                                                    TextColor="White"
                                                    FontSize="12"
                                                    Padding="5,3"
                                                    Grid.Column="1"
                                                    IsVisible="{Binding CanRate}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenRatingCommand}"
                                                    CommandParameter="{Binding .}"/>
                                                <Button Text="编辑" 
                                                    BackgroundColor="#D2691E" 
                                                    TextColor="White"
                                                    FontSize="12"
                                                    Padding="5,3"
                                                    Grid.Column="2"
                                                    IsVisible="{Binding CanEdit}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenEditReplyCommand}"
                                                    CommandParameter="{Binding .}"/>
                                                <Button Text="回复" 
                                                    BackgroundColor="#D2691E" 
                                                    TextColor="White"
                                                    FontSize="12"
                                                    Padding="5,3"
                                                    Grid.Column="3"
                                                    IsVisible="{Binding CanReply}" 
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenReplyCommentCommand}"
CommandParameter="{Binding .}"/>
                                            </Grid>

                                            <!-- 6. 回帖的评论部分（如有） -->
                                            <Border Padding="10" 
                                                Margin="0,8,0,0"
                                                StrokeShape="{RoundRectangle CornerRadius=3}" 
                                                Stroke="#E6F3FF" 
                                                StrokeThickness="0.5"
                                                BackgroundColor="{AppThemeBinding Light=#F9FBFD, Dark=#1E2D3D}"
                                                IsVisible="{Binding HasComments}">
                                                <VerticalStackLayout Spacing="5">
                                                    <Label Text="💭 点评" 
                                                       FontSize="11" 
                                                       FontAttributes="Bold"
                                                       TextColor="#1985DB"/>

                                                    <CollectionView ItemsSource="{Binding Comments}"
                                                                SelectionMode="None">
                                                        <CollectionView.ItemTemplate>
                                                            <DataTemplate x:DataType="models:CommentInfo">
                                                                <VerticalStackLayout Spacing="3" Margin="0,0,0,5">
                                                                    <Label Text="{Binding Username, StringFormat='{0}:'}"
                                                                       FontSize="10"
                                                                       FontAttributes="Bold"
                                                                       TextColor="#1985DB"/>
                                                                    <Label Text="{Binding CommentText}"
                                                                       FontSize="10"
                                                                       LineBreakMode="WordWrap"
                                                                       Margin="10,0,0,0"
                                                                       TextColor="{AppThemeBinding Light=#666666, Dark=#B0B0B0}"/>
                                                                </VerticalStackLayout>
                                                            </DataTemplate>
                                                        </CollectionView.ItemTemplate>
                                                    </CollectionView>
                                                </VerticalStackLayout>
                                            </Border>

                                            <!-- 7. 回帖的点评部分（如有） -->
                                            <Border Padding="10" 
                                                Margin="0,8,0,0"
                                                StrokeShape="{RoundRectangle CornerRadius=3}" 
                                                Stroke="#FFF0F5" 
                                                StrokeThickness="0.5"
                                                BackgroundColor="{AppThemeBinding Light=#FFF9FC, Dark=#3D1E3D}"
                                                IsVisible="{Binding HasRatings}">
                                                <VerticalStackLayout Spacing="5">
                                                    <Label Text="⭐ 评分" 
                                                       FontSize="11" 
                                                       FontAttributes="Bold"
                                                       TextColor="#C71585"/>

                                                    <CollectionView ItemsSource="{Binding RatingSummary.RatingDetails}"
                                                                SelectionMode="None">
                                                        <CollectionView.ItemTemplate>
                                                            <DataTemplate x:DataType="models:RatingInfo">
                                                                <VerticalStackLayout Spacing="3" Margin="0,0,0,5">
                                                                    <Label Text="{Binding Username, StringFormat='{0}:'}"
                                                                       FontSize="10"
                                                                       FontAttributes="Bold"
                                                                       TextColor="#C71585"/>
                                                                    <Label Text="{Binding RatingContent}"
                                                                       FontSize="10"
                                                                       LineBreakMode="WordWrap"
                                                                       Margin="10,0,0,0"
                                                                       TextColor="{AppThemeBinding Light=#666666, Dark=#B0B0B0}"/>
                                                                </VerticalStackLayout>
                                                            </DataTemplate>
                                                        </CollectionView.ItemTemplate>
                                                    </CollectionView>
                                                </VerticalStackLayout>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>


                <ActivityIndicator IsRunning="{Binding IsLoading}"
                              IsVisible="{Binding IsLoading}"
                              Color="#1985DB"/>

                <!-- 错误消息 -->
                <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   FontSize="12"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullToBoolConverter}}"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 页面中间短提示面板（预置，默认隐藏，由 ViewModel 控制显示/隐藏） -->
        <AbsoluteLayout IsVisible="True" InputTransparent="True" Grid.Row="0" HorizontalOptions="Center" VerticalOptions="End">
        <Border x:Name="TransientMessageFrame"
                Padding="10"
                StrokeShape="{RoundRectangle CornerRadius=8}"
                BackgroundColor="#CC000000"
                IsVisible="{Binding TransientMessageVisible}"
                Opacity="0"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Label Text="{Binding TransientMessageText}"
                   TextColor="White"
                   LineBreakMode="WordWrap"
                   HorizontalTextAlignment="Center"/>
        </Border>
        </AbsoluteLayout>

        <!-- 图片全屏覆盖层（在当前页面之上，不进行页面导航） -->
        <AbsoluteLayout x:Name="ImageOverlay" IsVisible="False" BackgroundColor="#CC000000" Grid.Row="0" InputTransparent="False">
            <ContentView x:Name="OverlayImageContainer"
                         AbsoluteLayout.LayoutBounds="0,0,1,1"
                         AbsoluteLayout.LayoutFlags="All" />

            <Button x:Name="OverlayDownloadButton"
                    AbsoluteLayout.LayoutBounds="0.97,0.95,50,50"
                    AbsoluteLayout.LayoutFlags="PositionProportional"
                    TextColor="White"
                    Shadow="Black 0 0"
                    BackgroundColor="Transparent"
                    BorderColor="White"
                    BorderWidth="2"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="10">
                <Button.ImageSource>
                    <FontImageSource Glyph="&#xe896;" Size="Medium" Color="White" FontFamily="Segoe Fluent Icons"/>
                </Button.ImageSource>
            </Button>

            <Button x:Name="OverlayCloseButton"
                    AbsoluteLayout.LayoutBounds="0.5,0.95,50,50"
                    AbsoluteLayout.LayoutFlags="PositionProportional"
                    TextColor="White" Shadow="Black 0 0"
                    BackgroundColor="Transparent"
                    BorderColor="White"
                    BorderWidth="3"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="30">
                <Button.ImageSource>
                    <FontImageSource Glyph="&#xE711;" Size="Medium" Color="White" FontFamily="Segoe Fluent Icons"/>
                </Button.ImageSource>
            </Button>
        </AbsoluteLayout>

        <!-- 点评表单模态框 -->
        <Border Padding="15" 
            BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D2D}"
            StrokeShape="{RoundRectangle CornerRadius=10}"
            IsVisible="{Binding CommentFormVisible}"
            Grid.Row="0"
            Grid.RowSpan="2"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            WidthRequest="320"
            Margin="20">
            <VerticalStackLayout Spacing="15">
                <!-- 标题 -->
                <Label Text="点评" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   TextColor="#1985DB"
                   HorizontalTextAlignment="Center"/>

                <!-- 被点评者信息 -->
                <Border Padding="10" 
                    StrokeShape="{RoundRectangle CornerRadius=5}" 
                    Stroke="#E6E6E6" 
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#1E1E1E}">
                    <Label Text="{Binding SelectedCommentTarget.Username, StringFormat='被点评者：{0}'}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#B0B0B0}"/>
                </Border>

                <!-- 点评内容输入框 -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="请输入点评内容:" 
                       FontSize="13" 
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#333333, Dark=White}"/>
                    <Editor Placeholder="请输入点评内容（最多200字）"
                       Text="{Binding CommentText}"
                       FontSize="12"
                       BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#3D3D3D}"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                       HeightRequest="120"
                       MaxLength="200"/>
                    <Label Text="{Binding CommentText.Length, StringFormat='{0:D}/200'}"
                       FontSize="10"
                       TextColor="{AppThemeBinding Light=#999999, Dark=#B0B0B0}"
                       HorizontalTextAlignment="End"/>
                </VerticalStackLayout>

                <!-- 提交和取消按钮 -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                    <Button Text="取消" 
                        BackgroundColor="#CCCCCC" 
                        TextColor="White"
                        FontSize="13"
                        Padding="5,5"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CloseCommentFormCommand}"/>
                    <Button Text="提交点评" 
                        BackgroundColor="#1985DB" 
                        TextColor="White"
                        FontSize="13"
                        Padding="5,5"
                        Grid.Column="1"
                        IsEnabled="{Binding IsSubmittingComment, Converter={StaticResource InvertedBoolConverter}}"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SubmitCommentCommand}"/>
                </Grid>

                <!-- 提交中指示器 -->
                <ActivityIndicator IsRunning="{Binding IsSubmittingComment}"
                              IsVisible="{Binding IsSubmittingComment}"
                              Color="#1985DB"/>
            </VerticalStackLayout>
        </Border>

        <!-- 评分表单模态框 -->
        <Border Padding="15" 
            BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D2D}"
            StrokeShape="{RoundRectangle CornerRadius=10}"
            IsVisible="{Binding RatingFormVisible}"
            Grid.Row="0"
            Grid.RowSpan="2"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            WidthRequest="320">
            <VerticalStackLayout Spacing="15">
                <!-- 标题 -->
                <Label Text="给帖子评分" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   TextColor="#D2691E"
                   HorizontalTextAlignment="Center"/>

                <!-- 用户信息 -->
                <Border Padding="10" 
                    StrokeShape="{RoundRectangle CornerRadius=5}" 
                    Stroke="#E6E6E6" 
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#1E1E1E}">
                    <Label Text="{Binding SelectedReply.Username, StringFormat='评分对象：{0}'}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#B0B0B0}"/>
                </Border>

                <!-- 评分范围信息 -->
                <Label Text="{Binding DailyRemaining, StringFormat='今日剩余评分次数：{0}'}"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light=#999999, Dark=#B0B0B0}"
                   HorizontalTextAlignment="Center"/>

                <!-- 评分分数选择器 -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="请输入评分（显示可评分范围）:" 
                       FontSize="13" 
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#333333, Dark=White}"/>

                    <!-- 显示可评分范围 -->
                    <Label Text="{Binding RatingRangeDisplay}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#B0B0B0}"
                           HorizontalTextAlignment="Center"/>

                    <!-- 评分输入框 -->
                    <Entry Placeholder="请输入分数（例如：3）"
                           Text="{Binding RatingScoreText}"
                           Keyboard="Numeric"
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#3D3D3D}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           Margin="20,0"/>

                    <!-- 当前输入显示 -->
                    <Label Text="{Binding RatingScoreText, StringFormat='当前输入：{0}分'}"
                       FontSize="12"
                       TextColor="#D2691E"
                       HorizontalTextAlignment="Center"
                       FontAttributes="Bold"/>
                </VerticalStackLayout>

                <!-- 评分理由（可选） -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="评分理由（可选）:" 
                       FontSize="13" 
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#333333, Dark=White}"/>
                    <Entry Placeholder="请输入评分理由（最多200字）"
                       Text="{Binding RatingReason}"
                       MaxLength="200"
                       FontSize="12"
                       BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#3D3D3D}"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                       PlaceholderColor="#CCCCCC"/>
                    <Label Text="{Binding RatingReason.Length, StringFormat='{0:D}/200'}"
                       FontSize="10"
                       TextColor="{AppThemeBinding Light=#999999, Dark=#B0B0B0}"
                       HorizontalTextAlignment="End"/>
                </VerticalStackLayout>

                <!-- 提交和取消按钮 -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                    <Button Text="取消" 
                        BackgroundColor="#CCCCCC" 
                        TextColor="White"
                        FontSize="13"
                        Padding="5,5"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CloseRatingFormCommand}"/>
                    <Button Text="提交评分" 
                        BackgroundColor="#D2691E" 
                        TextColor="White"
                        FontSize="13"
                        Padding="5,5"
                        Grid.Column="1"
                        IsEnabled="{Binding IsSubmittingRating, Converter={StaticResource InvertedBoolConverter}}"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SubmitRatingCommand}"/>
                </Grid>

                <!-- 提交中指示器 -->
                <ActivityIndicator IsRunning="{Binding IsSubmittingRating}"
                              IsVisible="{Binding IsSubmittingRating}"
                              Color="#D2691E"/>
            </VerticalStackLayout>
        </Border>

        <Grid ColumnDefinitions="*,*,*,*,*"  BackgroundColor="{AppThemeBinding Light=#F6F8FC, Dark=#202938}" Padding="0,5" IsVisible="{Binding HasContent}" Grid.Row="1">
            <StackLayout VerticalOptions="End">
                <Button IsEnabled="{Binding CanGoToPreviousPage}" Command="{Binding PreviousPageCommand}" Style="{StaticResource BottomNaviButtonStyle}">
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xE760;" Size="Large" Color="{AppThemeBinding Light=Black, Dark=White}" FontFamily="Segoe Fluent Icons"/>
                    </Button.ImageSource>
                </Button>
                <Label Text="上一页" HorizontalOptions="Center" FontSize="12" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
            </StackLayout>
            <StackLayout VerticalOptions="End" Grid.Column="1">
                <Button Command="{Binding RateThreadAuthorCommand}" Style="{StaticResource BottomNaviButtonStyle}">
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xE734;" Size="Medium" Color="{AppThemeBinding Light=Black, Dark=White}" FontFamily="Segoe Fluent Icons"/>
                    </Button.ImageSource>
                </Button>
                <Label Text="评分" HorizontalOptions="Center" FontSize="12" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
            </StackLayout>

            <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Grid.Column="2">
                <Label Text="当前第"/>
                <Label Text="{Binding CurrentPage}"/>
                <Label Text="页，共"/>
                <Label Text="{Binding TotalPage}"/>
                <Label Text="页"/>
            </StackLayout>

            <StackLayout VerticalOptions="End" Grid.Column="2">
                <Button IsVisible="{Binding CanEditOp}" Command="{Binding OpenEditOpReplyCommand}" Style="{StaticResource BottomNaviButtonStyle}">
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xE70f;" Size="Medium" Color="{AppThemeBinding Light=Black, Dark=White}" FontFamily="Segoe Fluent Icons"/>
                    </Button.ImageSource>
                </Button>
                <Label Text="编辑" HorizontalOptions="Center" FontSize="12" IsVisible="{Binding CanEditOp}" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
            </StackLayout>

            <StackLayout VerticalOptions="End" Grid.Column="3">
                <Button Command="{Binding OpenReplyThreadCommand}" Style="{StaticResource BottomNaviButtonStyle}" >
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xE90a;" Size="Medium" Color="{AppThemeBinding Light=Black, Dark=White}" FontFamily="Segoe Fluent Icons"/>
                    </Button.ImageSource>
                </Button>
                <Label Text="回复" HorizontalOptions="Center" FontSize="12" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
            </StackLayout>
            <StackLayout VerticalOptions="End" Grid.Column="4">
                <Button IsEnabled="{Binding CanGoToNextPage}" Command="{Binding NextPageCommand}" Style="{StaticResource BottomNaviButtonStyle}" >
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xE761;" Size="Large" Color="{AppThemeBinding Light=Black, Dark=White}" FontFamily="Segoe Fluent Icons"/>
                    </Button.ImageSource>
                </Button>
                <Label Text="下一页" HorizontalOptions="Center" FontSize="12" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>