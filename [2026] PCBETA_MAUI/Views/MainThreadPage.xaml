<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                          xmlns:vm="clr-namespace:PCBetaMAUI.ViewModels"
             x:Class="PCBetaMAUI.Views.MainThreadPage"
             x:Name="MainContent"  Shell.NavBarIsVisible="False"    >

    <ContentPage.BindingContext>
        <vm:MainThreadViewModel/>
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="BottomNaviButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=White}"/>
                <Setter Property="CornerRadius" Value="50"/>
                <Setter Property="BorderWidth" Value="2"/>
                <Setter Property="BorderColor" Value="LightBlue"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HeightRequest" Value="50"/>
                <Setter Property="WidthRequest" Value="50"/>
<!--
                                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="DodgerBlue"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="SkyBlue"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="LightBlue"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
                -->
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="50,*,80" BackgroundColor="{AppThemeBinding Light=#F6F8FC, Dark=#151A24}">

        <Grid ColumnDefinitions="180,*" Padding="18,0" BackgroundColor="{AppThemeBinding Light=White, Dark=#202938}">

            <Button Style="{StaticResource BottomNaviButtonStyle}" HeightRequest="45" WidthRequest="45" CornerRadius="5" Command="{Binding OpenMenuCommand}" HorizontalOptions="Start" Margin="-10,0,0,0" IsVisible="{OnPlatform Android=True, Default=False}">
                <Button.ImageSource>
                    <FontImageSource Glyph="&#xe700;" Size="Medium" Color="{AppThemeBinding Light=Black, Dark=White}" FontFamily="Segoe Fluent Icons"/>
                </Button.ImageSource>
            </Button>
            <Image Source="{OnPlatform 'pcbeta_logo_full.png', Android='pcbeta_logo_threadicon.png'}" Margin="{OnPlatform Android='45,0,0,0'}" HeightRequest="50" HorizontalOptions="Start"/>
            <Label Text="远景论坛 - 前沿科技与智慧生态的极客社区" HorizontalOptions="Start" VerticalOptions="Center" FontAttributes="Bold" FontSize="16" Margin="0" Grid.Column="1" TextColor="{AppThemeBinding Light=#1E293B, Dark=White}"/>
        </Grid>

        <!-- 加载指示器 -->
        <ActivityIndicator Grid.Row="1"
                          IsRunning="{Binding IsLoading}"
                          IsVisible="{Binding IsLoading}"
                          Color="#1985DB"
                          VerticalOptions="Center"
                          HorizontalOptions="Center"/>

        <!-- 错误消息 -->
        <!--<Label Grid.Row="0"
               Text="{Binding ErrorMessage}"
               TextColor="Red"
               FontSize="14"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullToBoolConverter}}"/>-->

        <!-- 论坛分类和板块列表 -->
        <ScrollView Grid.Row="1" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
            <VerticalStackLayout Padding="12,8" Spacing="4" BackgroundColor="{AppThemeBinding Light=#F6F8FC, Dark=#151A24}">
                <!-- 使用 CollectionView 遍历分类 -->
                <CollectionView ItemsSource="{Binding ForumCategories}"
                                SelectionMode="None">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="0" Padding="0">

                                <!-- 分类标题 - 可点击展开/收回 -->
                                <Grid ColumnDefinitions="*,40" Padding="18,14" BackgroundColor="{AppThemeBinding Light=#EAF2FF, Dark=#243653}" Margin="0,8,0,0">
                                    <Label Text="{Binding CategoryName}" 
                                           FontSize="15" 
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1985DB, Dark=#5DADE2}"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding IsExpanded, Converter={StaticResource ExpandedToSymbolConverter}}"
                                           FontSize="24"
                                           TextColor="{AppThemeBinding Light=#1985DB, Dark=#5DADE2}"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           Margin="0,0,10,0"/>

                                    <!-- 点击分类标题以展开/收回 -->
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleCategoryExpandedCommand}" 
                                                             CommandParameter="{Binding .}" 
                                                             NumberOfTapsRequired="1"/>
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <!-- 分类下的板块列表 - 使用 BindableLayout 简化绑定 -->
                                <VerticalStackLayout Padding="0,8,0,0" Spacing="8"
                                                     BindableLayout.ItemsSource="{Binding Sections}"
                                                     IsVisible="{Binding IsExpanded}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                             <Frame Padding="16" CornerRadius="14" Margin="4,0" BorderColor="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" BackgroundColor="{AppThemeBinding Light=White, Dark=#202938}">

                                                <!-- 使用 TapGestureRecognizer 处理板块点击 -->
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnForumTapped" CommandParameter="{Binding .}"/>
                                                     <PointerGestureRecognizer PointerEntered="OnForumPointerEntered" PointerExited="OnForumPointerExited"/>
                                                </Frame.GestureRecognizers>

                                                <Grid ColumnDefinitions="100,*">
                                                     <Image HeightRequest="48" Source="{Binding LogoSource}"/>
                                                    <VerticalStackLayout Spacing="8" Grid.Column="1">
                                                        <!-- 板块名称和今日新帖 - 横向排列 -->
                                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                            <StackLayout Orientation="Horizontal" Spacing="8">
                                                                <Label Text="{Binding Name}" 
                                                               FontSize="14" 
                                                               FontAttributes="Bold"
                                                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                                               VerticalOptions="Center"/>
                                                                <Label Text="{Binding TodayNewPosts, StringFormat='({0})'}" 
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               TextColor="Red"
                                                               VerticalOptions="Center"
                                                               IsVisible="{Binding TodayNewPosts, Converter={StaticResource StringToBoolConverter}}"/>
                                                            </StackLayout>
                                                            <Label Text="{Binding LastReply}" 
                                                               Grid.Column="1" 
                                                               FontSize="11" IsVisible="{OnPlatform Android=False}"
                                                               TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                                        </Grid>

                                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                            <Label Text="{Binding ThreadCount, StringFormat='主题: {0}'}" 
                                                               FontSize="11"
                                                               TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                                            <Label Text="{Binding PostCount, StringFormat='帖数: {0}'}" 
                                                               Grid.Column="1" 
                                                               FontSize="11"
                                                               TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                                        </Grid>

                                                        <Label Text="{Binding LastReply}" 
                                                   Grid.Column="1" 
                                                   FontSize="11" IsVisible="{OnPlatform False,Android=True}"
                                                   TextColor="{AppThemeBinding Light=Gray, Dark=#B0B0B0}"/>
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Frame>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 底部导航 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" BackgroundColor="{AppThemeBinding Light=#F6F8FC, Dark=#202938}" Padding="0,5">
            <StackLayout>
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource BottomNaviButtonStyle}" >
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xE72c;" Size="Medium" Color="{AppThemeBinding Light=Black, Dark=White}" FontFamily="Segoe Fluent Icons"/>
                    </Button.ImageSource>
                </Button>
                <Label Text="刷新" HorizontalOptions="Center" FontSize="12" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
            </StackLayout>
            <StackLayout Grid.Column="1">
                <Button Command="{Binding SearchCommand}" Style="{StaticResource BottomNaviButtonStyle}">
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xF0e2;" Size="Medium" Color="{AppThemeBinding Light=Black, Dark=White}" FontFamily="Segoe Fluent Icons"/>
                    </Button.ImageSource>
                </Button>
                <Label Text="发现" HorizontalOptions="Center" FontSize="12" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
            </StackLayout>
            <StackLayout Grid.Column="2">
                <Button Command="{Binding MyCommand}" Style="{StaticResource BottomNaviButtonStyle}">
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xE77b;" Size="Medium" Color="{AppThemeBinding Light=Black, Dark=White}" FontFamily="Segoe Fluent Icons"/>
                    </Button.ImageSource>
                </Button>
                <Label Text="我的" HorizontalOptions="Center" FontSize="12" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>
