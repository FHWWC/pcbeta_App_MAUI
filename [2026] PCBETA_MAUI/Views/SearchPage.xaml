<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PCBetaMAUI.ViewModels"
             x:Class="PCBetaMAUI.Views.SearchPage"
             Title="搜索帖子"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

    <ContentPage.BindingContext>
        <vm:SearchViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="BottomNaviButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=White}"/>
                <Setter Property="CornerRadius" Value="50"/>
                <Setter Property="BorderWidth" Value="2"/>
                <Setter Property="BorderColor" Value="LightBlue"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HeightRequest" Value="50"/>
                <Setter Property="WidthRequest" Value="50"/>
                <!--
                                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="DodgerBlue"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="SkyBlue"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="LightBlue"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
                -->
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid RowDefinitions="136,*,80" Padding="12,8" BackgroundColor="{AppThemeBinding Light=#F6F8FC, Dark=#151A24}">

        <!-- Top: Search box -->
        <Grid Grid.Row="0" RowDefinitions="*,*" ColumnDefinitions="*,100" VerticalOptions="Center">
            <Entry Text="{Binding SearchText}" Placeholder="请输入查找内容" BackgroundColor="{AppThemeBinding Light=White, Dark=#202938}" />
            <Button Text="立即搜" Background="DodgerBlue" Command="{Binding SearchCommand}" HorizontalOptions="End" Grid.Column="1">
                <Button.ImageSource>
                    <FontImageSource Glyph="&#xE773;" Size="Medium" Color="{AppThemeBinding Light=White, Dark=Black}" FontFamily="Segoe Fluent Icons"/>
                </Button.ImageSource>
            </Button>

            <HorizontalStackLayout Grid.Row="1">
                <RadioButton Content="按用户回复时间" IsChecked="{Binding IsLastPostChecked}" GroupName="OrderbyType"/>
                <RadioButton Content="按帖子发布时间" IsChecked="{Binding IsDatelineChecked}" GroupName="OrderbyType" Margin="10,0,0,0"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- Middle: Results list -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding SearchResults}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="16" Margin="2,4" CornerRadius="14" HasShadow="False" BorderColor="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" BackgroundColor="{AppThemeBinding Light=White, Dark=#202938}">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectThreadCommand}" CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="*,150">

                            <Grid RowDefinitions="*,2*,*">
                                <Label 
                                Text="{Binding Title}" 
                                FontAttributes="Bold" 
                                FontSize="14"
                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                LineBreakMode="TailTruncation"
                                MaxLines="2" />

                                <Label 
                                Text="{Binding PreviewContent}" 
                                FontSize="12"
                                TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}"
                                LineBreakMode="TailTruncation"
                                MaxLines="2" Grid.Row="1" Margin="0,12"/>

                                <Grid ColumnDefinitions="*,*,Auto" Grid.Row="2">
                                    <!-- Forum Name -->
                                    <Label 
                                    Text="{Binding ForumName}" 
                                    FontSize="11"
                                    TextColor="{AppThemeBinding Light=#FF6B6B, Dark=#FFB3B3}"

                                    LineBreakMode="TailTruncation" />
                                    <!-- Author -->
                                    <Label 
                                  Text="{Binding Author, StringFormat='作者: {0}'}" 
                                  FontSize="10"
                                  TextColor="{AppThemeBinding Light=Gray, Dark=#CCCCCC}"
                                  VerticalOptions="Center"
                                  LineBreakMode="TailTruncation" Grid.Column="1"/>

                 
                                </Grid>

                            </Grid>

                            <Grid RowDefinitions="*,*,*" Grid.Column="1" >
                                <!-- Thread ID (hidden but available) -->
                                <Label Text="{Binding Id, StringFormat='ID {0}'}"  FontSize="12" TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#CCCCCC}"  HorizontalOptions="End"/>

                                <Grid ColumnDefinitions="*,*" Margin="0,12" Grid.Row="1" >
                                    <!-- Replies Count -->
                                    <VerticalStackLayout>
                                        <Label 
                                        Text="{Binding Replies}" 
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light=#4C6EF5, Dark=#7FA3FF}"
                                        HorizontalTextAlignment="Center"          />
                                        <Label 
                                        Text="回复" 
                                        FontSize="10"
                                        TextColor="{AppThemeBinding Light=Gray, Dark=#CCCCCC}"
                                        HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>

                                    <!-- Views Count -->
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label 
                                        Text="{Binding Views}" 
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light=#51CF66, Dark=#8FE6A1}"
                                        HorizontalTextAlignment="Center" />
                                        <Label 
                                        Text="查看" 
                                        FontSize="10"
                                        TextColor="{AppThemeBinding Light=Gray, Dark=#CCCCCC}"
                                        HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- PostTime -->
                                <Label Text="{Binding PostTime, StringFormat='发布时间 {0:yyyy-MM-dd HH:mm}'}" 
                 FontSize="10" TextColor="{AppThemeBinding Light=#999999, Dark=#BBBBBB}" Grid.Row="2" HorizontalOptions="End" VerticalOptions="End"/>
                            </Grid>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom: Pagination and refresh -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center" IsVisible="False">
            <Button Text="上一页" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" />
            <Label Text="{Binding PageDisplay}" HorizontalOptions="Center" VerticalOptions="Center" />
            <Button Text="下一页" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" />
        </Grid>

        <Grid Grid.Row="2">
            <StackLayout VerticalOptions="End">
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource BottomNaviButtonStyle}">
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xE72c;" Size="Medium" Color="{AppThemeBinding Light=Black, Dark=White}" FontFamily="Segoe Fluent Icons"/>
                    </Button.ImageSource>
                </Button>
                <Label Text="刷新" HorizontalOptions="Center" FontSize="12" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>
